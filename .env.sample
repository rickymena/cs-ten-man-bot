# 10-man bot settings. Copy to .env and fill in the PASTE_ values.
# Values still starting with PASTE_ are treated as unset.

# --- Secrets ------------------------------------------------------------------
# In a container, put the token and webhook in secrets/discord_token and
# secrets/discord_webhook_url instead (see compose.docker.yaml) and delete
# these two lines: an environment variable shows up in `docker inspect`.
# They're here for running bot.py / devtool.py directly on your PC.
#
# Webhook (enough to test alerts with devtool.py, no bot needed):
# Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=PASTE_WEBHOOK_URL_HERE

# --- Bot (needed for /tenman commands and buttons) ---------------------------
# discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=PASTE_BOT_TOKEN_HERE
# Right-click server / channel / role -> Copy ID (enable Developer Mode first)
GUILD_ID=PASTE_SERVER_ID_HERE
CHANNEL_ID=PASTE_CHANNEL_ID_HERE
# The role to ping in alerts (e.g. @10-man). Leave as is to post without pinging.
TENMAN_ROLE_ID=PASTE_ROLE_ID_HERE

# --- Behaviour (defaults shown) ----------------------------------------------
TIMEZONE=America/New_York
ALERT_TIME=12:00
GAMEDAY_ALERT_HOURS_BEFORE=2
ALERT_CATCHUP_HOURS=3
TENMAN_SLOTS=10
TENMAN_MAX_GUESTS=1
# Who posts alerts once the bot runs: "bot" (default) or "webhook"
ALERTS_VIA=bot
# Optional: only allow lobby links on these domains (comma-separated, subdomains ok)
# LOBBY_ALLOWED_HOSTS=popflash.site
# Spam limits (defaults shown)
TENMAN_MAX_OPEN_PER_CHANNEL=5
TENMAN_MAX_OPEN_PER_USER=2
TENMAN_CLICK_COOLDOWN_SECONDS=1
# --- Scheduling limits (defaults shown) ---------------------------------------
SCHEDULE_POST_DAYS_BEFORE=3
TENMAN_MAX_SCHEDULED_PER_CHANNEL=20
TENMAN_MAX_SERIES_PER_CHANNEL=3

# --- Healthcheck thresholds in seconds (defaults shown) -----------------------
# HEALTH_MAX_TICK_AGE=120
# HEALTH_GATEWAY_GRACE=600
# HEALTH_DB_JOB_MAX=60

# Daily database backup (local time) and where it goes
BACKUP_TIME=04:00
# Relative paths are inside the project folder
# BACKUP_DIR=backups
# DB_PATH=data/tenman.db
